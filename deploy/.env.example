# Docker Compose 环境变量（复制为 deploy/.env 后修改）

# 对外访问地址（浏览器打开前端的 URL，不要末尾斜杠）
# 同时作为 CORS 与文件 URL 前缀（FILE_SERVER_BASE_URL）
PUBLIC_URL=http://localhost:8080

# 安全（生产环境务必修改为 ≥32 位随机串）
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# JWT（可选覆盖）
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PostgreSQL
POSTGRES_USER=dasshine
POSTGRES_PASSWORD=dasshine123
POSTGRES_DB=dasshine_label

# 可选：映射到宿主机的端口
HTTP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# 后端
DEBUG=false
LOG_LEVEL=INFO

# CORS：默认等于 PUBLIC_URL；多源用逗号分隔，例如：
# BACKEND_CORS_ORIGINS=http://localhost:8080,https://label.example.com

# 上传 / 文件服务（Compose 已设 UPLOAD_DIR=/app/uploads）
# FILE_SERVER_BASE_URL 默认跟随 PUBLIC_URL（Nginx 反代 /uploads）

# 预标注（可选，需镜像内安装 ultralytics 等）
PRELABEL_ENABLE_LOCAL=false
