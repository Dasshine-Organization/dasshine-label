# Frontend env (Vite)

# API base (default in code: http://localhost:8000/api/v1)
# VITE_API_URL=http://localhost:8000/api/v1

# Show hard-coded demo task entries on Dashboard.
# - unset: enabled in `vite` DEV, disabled in production build
# - true / false: force on / off
# Production Docker defaults to false. Backend DEMO_ENTRIES_ENABLED=false also kills demos at runtime.
# VITE_ENABLE_DEMO_ENTRIES=false
