# Dasshine Label 环境配置

# 应用配置
APP_NAME=Dasshine Label
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# 安全配置（生产环境必须修改）
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# P18 企业接入
AUTH_REGISTER_ENABLED=true
# OIDC_ENABLED=true
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
FRONTEND_URL=http://localhost:5173
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@dasshine.local
ORG_INVITE_EXPIRE_DAYS=7
WEBHOOK_TIMEOUT_SEC=10

# 限流（每分钟；优先 Redis，不可用则进程内存）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_API_PER_MINUTE=180
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CLAIM_PER_MINUTE=40
RATE_LIMIT_IMPORT_PER_MINUTE=30

# P11 共编 / 计费
COLLAB_ENABLED=true
BILLING_ENABLED=true
BILLING_CREDIT_PER_IMPORT_TASK=1
BILLING_CREDIT_PER_EXPORT=10

# P12 Stripe（可选）
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_SUCCESS_URL=http://localhost:3000/projects?billing=success
# STRIPE_CANCEL_URL=http://localhost:3000/projects?billing=cancel
# STRIPE_CREDIT_PACKS=[{"id":"pack_1k","credits":1000,"amount_cents":999,"label":"1k 积分"}]
# P13 订阅（可选）
# STRIPE_PRICE_PLANS=[{"id":"plan_pro","price_id":"price_xxx","credits_per_month":5000,"label":"Pro"}]
# STRIPE_PORTAL_RETURN_URL=http://localhost:3000/projects?billing=portal
# P14 Tax / Connect（可选）
# STRIPE_TAX_ENABLED=true
# STRIPE_CONNECT_ENABLED=true
# STRIPE_CONNECT_COUNTRY=US
# STRIPE_CONNECT_RETURN_URL=http://localhost:3000/projects?billing=connect
# STRIPE_APPLICATION_FEE_BPS=1000
# P14 NFS/FUSE
# STORAGE_OS_MOUNT_ENABLED=false
# STORAGE_OS_MOUNT_ALLOW_ROOTS=/mnt/dasshine,/Volumes/dasshine
# STORAGE_REQUIRE_OS_MOUNT=false
STORAGE_BROWSE_ALLOW_PREFIXES=projects/

# 数据库配置
DATABASE_URL=postgresql://dasshine:dasshine123@localhost:5432/dasshine_label
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis配置
REDIS_URL=redis://localhost:6379/0

# CORS配置
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 文件上传配置
UPLOAD_DIR=./uploads
# 文件服务对外访问根地址（导入图片后的 data_url 前缀，默认本机后端）
FILE_SERVER_BASE_URL=http://localhost:8000
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=.txt,.pdf,.jpg,.jpeg,.png,.json,.csv,.jsonl

# 存储后端：local（默认）| s3（兼容 MinIO / AWS S3 / 阿里云 OSS S3）
STORAGE_BACKEND=local
# --- S3 兼容（STORAGE_BACKEND=s3 时必填）---
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET=dasshine-label
# S3_REGION=us-east-1
# S3_PREFIX=dasshine
# S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/dasshine-label
# S3_FORCE_PATH_STYLE=true
# S3_VERIFY_SSL=true

# 自动标注（HTTP 适配器，不在进程内训练）
AUTO_LABEL_ENABLED=true
AUTO_LABEL_CONFIDENCE_THRESHOLD=0.8
# 无 LLM/Whisper/OCR 端点时：DEBUG 或本开关允许启发式 demo（CI / 本地）
AUTO_LABEL_ALLOW_DEMO=true
# AUTO_LABEL_AUTO_SUBMIT=false
# OpenAI 兼容 Chat Completions（NER / 分类 / 情感 / 摘要 / caption）
# AUTO_LABEL_LLM_BASE_URL=https://api.openai.com/v1
# AUTO_LABEL_LLM_API_KEY=sk-...
# AUTO_LABEL_LLM_MODEL=gpt-4o-mini
# Whisper / ASR：POST {audio_url} → {text, segments, confidence}
# AUTO_LABEL_WHISPER_ENDPOINT=http://127.0.0.1:9001/v1/transcribe
# AUTO_LABEL_WHISPER_API_KEY=
# OCR：POST {image_url} → {texts:[{text,bbox,confidence}]} 或 PaddleOCR results
# AUTO_LABEL_OCR_ENDPOINT=http://127.0.0.1:9002/v1/ocr
# AUTO_LABEL_OCR_API_KEY=
# AUTO_LABEL_HTTP_TIMEOUT=60

# 2D 预标注模型（可选）
PRELABEL_ENABLE_LOCAL=true
PRELABEL_LOCAL_WEIGHTS_DIR=./models
PRELABEL_YOLO_WEIGHTS=yolov8n.pt
# PRELABEL_HF_API_TOKEN=hf_xxx
PRELABEL_HF_MODEL_ID=hustvl/yolos-tiny
PRELABEL_HF_DETR_MODEL_ID=facebook/detr-resnet-50
# PRELABEL_HTTP_ENDPOINT=http://127.0.0.1:9000/v1/detect
# PRELABEL_HTTP_API_KEY=

# 任务分发配置
TASK_DISPATCH_BATCH_SIZE=100
TASK_DISPATCH_INTERVAL=60

# 质量控制配置
QUALITY_GOLDEN_RATIO=0.1
QUALITY_MIN_AGREEMENT=0.8
